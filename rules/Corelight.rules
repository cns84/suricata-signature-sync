### ATSVC
alert tcp any any -> $HOME_NET any (msg:"CORELIGHT LATERAL DCERPC ATSVC v1.0 Bind (flowbits set)"; flow:established; content:"|05 00 0b 03 10 00 00 00|"; content:"|82 06 f7 1f 51 0a e8 30 07 6d 74 0b e8 ce e9 8b|"; distance:24; within:16; flowbits:set,atsvc.bind; flowbits:noalert; reference:url,401trg.com/an-introduction-to-smb-for-network-security-analysts/; classtype:attempted-admin; sid:3000487; rev:1; metadata:created_at 2025_09_19, updated_at 2025_09_19, mitre_tactic_id TA0008, mitre_technique_id T1021;)

# content:"|00 00 00 00 00|"; == 3 null bytes for UTF16-LE null terminator + 2 \x00 padding for beginning of jobinfo block
# content:!"|00 00 00 00|"; == non-null job time (47100000 in Nate's pcaps, this is expressed as milliseconds after midnight)
# content:"|00 00 00 00 00 00|"; distance:4; within:6; == jobinfo contains null values for day of month, week, and flags
# content:"|00 2e 00 65 00 78 00 65 00 00 00|"; distance:0; == ".exe\x00" as UTF16-LE
alert tcp any any -> $HOME_NET any (msg:"CORELIGHT LATERAL ATSVC JobAdd Request With .exe File Extension and Immediate Start"; flow:established; content:"|05 00 00 03 10 00 00 00|"; content:"|00 00|"; distance:14; within:2; content:"|00 5c 00 5c|"; distance:0; content:"|00 00 00 00 00|"; distance:0; content:!"|00 00 00 00|"; distance:0; within:4; content:"|00 00 00 00 00 00|"; distance:4; within:6; content:"|00 2e 00 65 00 78 00 65 00 00 00|"; distance:0; flowbits:isset,atsvc.bind; reference:url,401trg.com/an-introduction-to-smb-for-network-security-analysts/; reference:url,github.com/fortra/impacket/blob/171a324d3a2a5c0987330ada447e3044bb5d9d84/impacket/dcerpc/v5/atsvc.py#L121; reference:url,learn.microsoft.com/en-us/openspecs/windows_protocols/ms-tsch/7290597e-bb6d-46fe-9338-e6b0467b23ae; classtype:attempted-admin; sid:3000488; rev:1; metadata:created_at 2025_09_19, updated_at 2025_09_19, mitre_tactic_id TA0002, mitre_technique_id T1053;)

