# DCShadow Attack Detection Rules
# Detects DRSReplicaAdd and DRSReplicaDel on the DRSUAPI interface via raw
# content matching (avoids dce_iface issues per OISF#3109).
# DRSUAPI UUID (wire format): 35 42 51 e3 06 4b d1 11 ab 04 00 c0 4f c2 dc d2

# Step 1: Set flowbit on DRSUAPI bind (05 00 0b = DCE/RPC v5.0 bind)
alert tcp any any -> $HOME_NET any (msg:"CORELIGHT LATERAL - DCShadow - DRSUAPI Bind (flowbit set)"; flow:established,to_server; content:"|05 00 0b|"; depth:3; content:"|35 42 51 e3 06 4b d1 11 ab 04 00 c0 4f c2 dc d2|"; depth:100; flowbits:set,drsuapi; flowbits:noalert; classtype:attempted-admin; sid:3000588; rev:2; metadata:created_at 2026_04_21, mitre_tactic_id TA0005, mitre_technique_id T1207;)

# Step 2: DRSReplicaAdd request (opnum 5, LE: 05 00) - sets DCShadow flowbit, no alert
alert tcp any any -> $HOME_NET any (msg:"CORELIGHT LATERAL - DCShadow - DRSUAPI DRSReplicaAdd Request (flowbit set)"; flow:established,to_server; flowbits:isset,drsuapi; content:"|05 00 00|"; depth:3; content:"|05 00|"; offset:22; depth:2; flowbits:set,dcshadow.replica_add; flowbits:noalert; classtype:attempted-admin; sid:3000589; rev:2; metadata:created_at 2026_04_21, mitre_tactic_id TA0005, mitre_technique_id T1207;)

# Step 3: DRSReplicaDel request (opnum 6, LE: 06 00) after DRSReplicaAdd - confirms DCShadow
# Unsets the flowbit after firing to prevent duplicate alerts from stream re-inspection.
alert tcp any any -> $HOME_NET any (msg:"CORELIGHT LATERAL DCShadow Pattern - Directory Replica Added and Deleted"; flow:established,to_server; flowbits:isset,drsuapi; flowbits:isset,dcshadow.replica_add; content:"|05 00 00|"; depth:3; content:"|06 00|"; offset:22; depth:2; flowbits:unset,dcshadow.replica_add; classtype:attempted-admin; sid:3000590; rev:2; metadata:created_at 2026_04_21, mitre_tactic_id TA0005, mitre_technique_id T1207;)
