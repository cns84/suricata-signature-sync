# React2Shell 2025-12 CVE-2025-55182 & CVE-2025-66478
# High fidelity check for the specific Assetnote PoC payload ($1:a:a)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CORELIGHT EXPLOIT Next.js RSC RCE Exploit Attempt (CVE-2025-55182)"; flow:established,to_server; http.method; content:"POST"; http.request_header; content:"Next-Action"; http.content_type; content:"multipart/form-data"; http.request_body; content:"[\"$1:a:a\"]"; fast_pattern; reference:cve,2025-55182; reference:url,react2shell.com; classtype:attempted-admin; sid:3000491; rev:2; metadata:created_at 2025_12_04, mitre_tactic_id TA0001, mitre_technique_id T1190;)

# Response check: This detects if a server actually responded with the specific error indicating vulnerability
# Note: direction is HOME -> EXTERNAL to catch the egress response
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CORELIGHT EXPLOIT Next.js RSC Vulnerable Response Observed (CVE-2025-55182)"; flow:established,to_client; http.stat_code; content:"500"; http.content_type; content:"text/x-component"; http.response_body; content:"E{\"digest\""; fast_pattern; reference:cve,2025-55182; classtype:successful-recon-limited; sid:3000492; rev:3; metadata:created_at 2025_12_04, mitre_tactic_id TA0001, mitre_technique_id T1190;)

# PCRE Evasion detection: Catches variations of the object reference (e.g. $2:b:b or $100:x:y)
# This is slightly more expensive but catches attackers trying to bypass static string matching
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CORELIGHT EXPLOIT Next.js RSC RCE Evasion Attempt (PCRE Match) (CVE-2025-55182)"; flow:established,to_server; http.method; content:"POST"; http.request_header; content:"Next-Action"; http.content_type; content:"multipart/form-data"; http.request_body; pcre:"/\[\"\$\d+:[a-zA-Z0-9_]+:[a-zA-Z0-9_]+\"\]/P"; reference:cve,2025-55182; classtype:attempted-admin; sid:3000493; rev:2; metadata:created_at 2025_12_04, mitre_tactic_id TA0001, mitre_technique_id T1190;)

# Detection for the specific scanner tool released by Assetnote
# Detects the hardcoded Next-Router-State-Tree header used in their research script
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CORELIGHT HUNTING Suspicious Next.js Router State (Assetnote Scanner)"; flow:established,to_server; http.method; content:"POST"; http.header.raw; content:"Next-Router-State-Tree"; content:"%5B%22%22%2C%7B%22children%22%3A%5B%22__PAGE__%22%2C%7B%7D%2Cnull%2Cnull%5D%7D%2Cnull%2Cnull%2Ctrue%5D"; fast_pattern; reference:url,github.com/assetnote/react2shell-scanner; classtype:web-application-attack; sid:3000494; rev:2; metadata:created_at 2025_12_04, mitre_tactic_id TA0001, mitre_technique_id T1190;)

