############ Rules relating to PERFCTL C2 (RES-2335)
# Detect download using hardwired curl UA 
alert http $HOME_NET any -> any any (msg:"CORELIGHT MALWARE perfctl malware - fetch payload"; flow:to_server; http.user_agent; content:"curl/7.74.9"; http.uri; content:"/main/dist/avatar.php"; startswith; reference:url,www.aquasec.com/blog/perfctl-a-stealthy-malware-targeting-millions-of-linux-servers/; classtype:trojan-activity; sid:3000290; rev:1; metadata:mitre_tactic_id TA0011, mitre_technique_id T1105, created_at 2024_10_08;)

# Detect outbound XMRig cryptominer logins (part of PERFCTL but also a general rule)
alert tcp $HOME_NET any -> any any (msg:"CORELIGHT MALWARE XMRig Cryptominer Login Attempt"; flow:to_server; content:"|7b 22 69 64 22 3a|"; startswith; content:"|22 2c 22 61 67 65 6e 74 22 3a 22 58 4d 52 69 67|"; distance:0; within:300; threshold:type limit, track by_src, seconds 300, count 1; reference:url,www.aquasec.com/blog/perfctl-a-stealthy-malware-targeting-millions-of-linux-servers/; classtype:trojan-activity; sid:3000291; rev:1; metadata:created_at 2024_10_08, mitre_tactic_id TA0011, mitre_technique_id T1496;)

# Detect download of likely kit script (part of PERFCTL but also a general rule)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CORELIGHT MALWARE Suspicious Commands in Shell Script - Likely Secondary Malware."; flow:to_client; http.response_body; content:"#!/bin/bash"; distance:0, within 15; pcre:"/(?:curl|wget)\s/"; within:1000; content:"chmod "; distance:0; within:1000; reference:url,www.aquasec.com/blog/perfctl-a-stealthy-malware-targeting-millions-of-linux-servers/; classtype:trojan-activity; sid:3000292; rev:1; metadata:created_at 2024_10_08, mitre_tactic_id TA0011, mitre_technique_id T1071;)

