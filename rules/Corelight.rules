## AsyncRAT
alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"CORELIGHT MALWARE AsyncRAT Style TLS Certificate"; flow:established,to_client; tls.cert_issuer; content:"RAT|20|Server"; nocase; endswith; tls.cert_subject; content:"Rat"; nocase; reference:url,any.run/malware-trends/asyncrat; classtype:trojan-activity; sid:3000070; rev:1; metadata:created_at 2024_06_01, mitre_tactic_id TA0011, mitre_technique_id T1071;)

#
# logic to catch variants like:
#   "subject": "CN=VenomRAT",
#   "issuerdn": "CN=MONEY, OU=qwqdanchun, O=VenomRAT By qwqdanchun, L=SH, C=CN",
alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"CORELIGHT MALWARE AsyncRAT Variant Style TLS Certificate"; flow:established,to_client; tls.cert_issuer; content:"By|20|qwqdanchun"; reference:url,any.run/malware-trends/asyncrat; reference:url,github.com/qwqdanchun/DcRat/blob/30ca53b068b4ab7a2542835f7456abd26e1a0ed4/Server/Helper/CreateCertificate.cs#L32; classtype:trojan-activity; sid:3000071; rev:1; metadata:created_at 2024_06_01, mitre_tactic_id TA0011, mitre_technique_id T1071;)

